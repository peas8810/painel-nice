/** Emissão em lote aditiva. Não utiliza o envio individual. */
const NICE_BATCH_HEADERS=['LOTE_ID','CURSO_ID','ARQUIVO_ID','SOLICITACAO_ID','CRIADO_EM'];
function instalarEmissaoLotes(){niceBatchSheet_();niceBatchIssueHeaders_();if(!ScriptApp.getProjectTriggers().some(t=>t.getHandlerFunction()==='processarLotesCertificados'))ScriptApp.newTrigger('processarLotesCertificados').timeBased().everyMinutes(1).create();}
function niceBatchSheet_(){return niceCertSheet_(niceMaster_(),'CERT_LOTES',NICE_BATCH_HEADERS);}
function niceBatchIssueHeaders_(){niceCertCustomEnsureIssueHeaders_();const sh=niceCertIssuesSheet_();['LOTE_ID','EMAIL_ENTREGA_LOTE'].forEach(k=>{const heads=sh.getRange(1,1,1,sh.getLastColumn()).getDisplayValues()[0];if(!heads.includes(k))sh.getRange(1,sh.getLastColumn()+1).setValue(k);});}
function niceBatchResolve_(p,admin){if(admin){const c=niceCoursesAll_().find(c=>c.id===p.curso_id);if(!c)throw new Error('Evento não encontrado.');return{c,link:niceCertCustomGetLinkById_(c.link_id)}}return niceCoursesLoadClient_(p.chave);}
function niceBatchLoad_(id){const v=niceBatchSheet_().getDataRange().getValues(),r=v.slice(1).find(r=>r[0]===id);if(!r)throw new Error('Lote não encontrado.');const file=DriveApp.getFileById(String(r[2]));return{job:JSON.parse(file.getBlob().getDataAsString()),file};}
function niceBatchSave_(holder){holder.job.atualizado_em=new Date().toISOString();holder.file.setContent(JSON.stringify(holder.job));}
function niceBatchItems_(items,c){if(!Array.isArray(items)||!items.length||items.length>100)throw new Error('Informe de 1 a 100 pessoas.');const seen={};return items.map((p,i)=>{const nome=niceCoursesText_(p.nome,180),funcao=String(p.funcao||'Participante'),carga=Number(String(p.carga||'').replace(',','.')),email=String(p.email||'').trim().toLowerCase(),tema=niceCoursesText_(p.tema||'',180);if(nome.length<3||!NICE_COURSES_ROLES.includes(funcao)||!Number.isFinite(carga)||carga<=0||carga>10000||email&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))throw new Error('Linha '+(i+1)+': confira nome, função, horas e e-mail opcional.');if(funcao==='Concluinte'&&p.aprovado!==true)throw new Error('Linha '+(i+1)+': confirme os critérios de conclusão.');const identity=email||'nome:'+niceCoursesPersonIdentity_(nome),key=identity+'|'+funcao;if(seen[key])throw new Error('Pessoa e função duplicadas na linha '+(i+1));seen[key]=true;niceCoursesSignatories_(c,{nome,email,funcao});return{nome,funcao,carga:String(carga)+' horas',email,tema,aprovado:p.aprovado===true,identity,status:'PENDENTE',erro:''};});}
function niceBatchDispatch_(p,admin){const op=String(p.operacao||'status'),{c,link}=niceBatchResolve_(p,admin);if(op==='criar')return niceBatchCreate_(p,c,link);const holder=niceBatchLoad_(p.lote_id);if(holder.job.curso_id!==c.id)throw new Error('Lote não pertence a este evento.');if(op==='retomar')return niceBatchRetry_(holder,c);return niceBatchPublic_(holder.job);}
function niceBatchPublic_(job){return{ok:true,lote:{id:job.id,curso_id:job.curso_id,titulo:job.titulo,destino:job.destino,status:job.status,total:job.items.length,concluidos:job.items.filter(x=>x.status==='CONCLUIDO').length,falhas:job.items.filter(x=>x.status==='FALHOU').length,zip_url:job.zip_url||'',entrega:job.entrega||'',erro:job.erro||'',items:job.items.map(x=>({nome:x.nome,funcao:x.funcao,status:x.status,codigo:x.codigo||'',erro:x.erro||''}))}};}
function niceBatchCreate_(p,c,link){const destino=String(p.destino||'').trim().toLowerCase();if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(destino))throw new Error('Informe o e-mail único para entrega.');const items=niceBatchItems_(JSON.parse(p.items||'[]'),c),request=String(p.solicitacao_id||'');if(!/^[A-Za-z0-9_-]{8,100}$/.test(request))throw new Error('Solicitação inválida.');if(!ScriptApp.getProjectTriggers().some(t=>t.getHandlerFunction()==='processarLotesCertificados'))throw new Error('Execute instalarEmissaoLotes no Apps Script antes de criar o lote.');if(!niceCertEmissionWindow_({STATUS:link.status,EMISSAO_INICIO:link.emissao_inicio,EMISSAO_FIM:link.emissao_fim}).open)throw new Error('Emissão fechada para este evento.');
const lock=LockService.getScriptLock();lock.waitLock(30000);try{const sh=niceBatchSheet_(),values=sh.getDataRange().getValues(),previous=values.slice(1).find(r=>r[3]===request);if(previous){const job=niceBatchLoad_(previous[0]).job;if(job.curso_id!==c.id)throw new Error('Solicitação inválida.');niceBatchEnsureReservations_(job,c);return niceBatchPublic_(job);}c=niceCoursesByLink_(link.id);niceCoursesBaselineLocked_(c);const q=niceCoursesQuota_(c);if(q.disponiveis<items.length)throw new Error('Saldo insuficiente: '+q.disponiveis+' disponível(is) para '+items.length+' certificados.');const counts={};items.forEach(x=>counts[x.identity]=(counts[x.identity]||0)+1);Object.keys(counts).forEach(identity=>{const used=niceCoursesQuota_(c,identity).pessoa_usados;if(used+counts[identity]>q.limite_pessoa)throw new Error('Limite por titular excedido: '+identity.replace(/^nome:/,''));});
items.forEach(item=>item.codigo='CERT-UJN-CUS-'+Utilities.getUuid().replace(/-/g,'').slice(0,10).toUpperCase());const id='LOTE-'+Utilities.getUuid(),job={id,curso_id:c.id,link_id:c.link_id,titulo:c.titulo,destino,modelo:c,status:'PENDENTE',entrega:'PENDENTE',items,criado_em:new Date().toISOString()},folder=niceCertFolderFromUrl_(link.pasta_drive),file=folder.createFile(Utilities.newBlob(JSON.stringify(job),'application/json',id+'.json'));niceCertAppendObject_(sh,{LOTE_ID:id,CURSO_ID:c.id,ARQUIVO_ID:file.getId(),SOLICITACAO_ID:request,CRIADO_EM:new Date()});niceBatchEnsureReservations_(job,c);niceCertLog_('LOTE_CRIADO',c.id,id,items.length+' certificados · destino '+destino);return niceBatchPublic_(job);}finally{lock.releaseLock();}}
function niceBatchQuotaFinish_(job,index,status,code){const sh=niceCoursesQuotaSheet_(),v=sh.getDataRange().getValues(),h=niceCertHeaderMap_(v[0]),row=v.findIndex((r,i)=>i>0&&r[h.SOLICITACAO_ID]===job.id+'-'+index);if(row<1)throw new Error('Reserva de lote não encontrada.');niceCoursesFinishQuota_(row+1,status,code||'','');}
function niceBatchRetry_(holder,c){const lock=LockService.getScriptLock();lock.waitLock(30000);try{if(['PROCESSANDO','ENTREGANDO'].includes(holder.job.status))throw new Error('O lote ainda está em processamento.');const failed=holder.job.items.filter(x=>x.status==='FALHOU');if(niceCoursesQuota_(c).disponiveis<failed.length)throw new Error('Saldo insuficiente para retomar.');const counts={};failed.forEach(x=>counts[x.identity]=(counts[x.identity]||0)+1);Object.keys(counts).forEach(identity=>{const q=niceCoursesQuota_(c,identity);if(q.pessoa_usados+counts[identity]>q.limite_pessoa)throw new Error('Limite do titular atingido: '+identity.replace(/^nome:/,''));});const sh=niceCoursesQuotaSheet_(),v=sh.getDataRange().getValues(),h=niceCertHeaderMap_(v[0]);holder.job.items.forEach((x,i)=>{if(x.status!=='FALHOU')return;const q=niceCoursesQuota_(c,x.identity);if(q.pessoa_usados>=q.limite_pessoa)throw new Error('Limite do titular atingido: '+x.nome);const row=v.findIndex((r,k)=>k>0&&r[h.SOLICITACAO_ID]===holder.job.id+'-'+i);niceCertSetByMap_(sh,row+1,h,'STATUS','RESERVADO');x.status='PENDENTE';x.erro='';});holder.job.status='PENDENTE';holder.job.erro='';if(holder.job.entrega==='FALHOU')holder.job.entrega='PENDENTE';niceBatchSave_(holder);return niceBatchPublic_(holder.job);}finally{lock.releaseLock();}}
function processarLotesCertificados(){const started=Date.now(),props=PropertiesService.getScriptProperties(),lock=LockService.getScriptLock();lock.waitLock(30000);try{const lease=Number(props.getProperty('CERT_LOTES_WORKER')||0);if(lease&&started-lease<8*60000)return;props.setProperty('CERT_LOTES_WORKER',String(started));}finally{lock.releaseLock();}try{niceBatchIssueHeaders_();const rows=niceBatchSheet_().getDataRange().getValues().slice(1);let processed=0;for(const row of rows){if(processed>=5||Date.now()-started>200000)break;const holder=niceBatchLoad_(row[0]),job=holder.job;if(!['PENDENTE','PROCESSANDO'].includes(job.status))continue;const current=niceCoursesAll_().find(c=>c.id===job.curso_id),c=job.modelo||current,link=current&&niceCertCustomGetLinkById_(c.link_id);if(!c||!link){job.status='FALHOU';job.erro='Evento não encontrado.';niceBatchSave_(holder);continue;}
if(!niceCertEmissionWindow_({STATUS:link.status,EMISSAO_INICIO:link.emissao_inicio,EMISSAO_FIM:link.emissao_fim}).open){job.status='PAUSADO';job.erro='Emissão fechada. Reabra o link e retome o lote.';niceBatchSave_(holder);continue;}job.items.forEach((item,i)=>{if(item.status==='CONCLUIDO')niceBatchQuotaFinish_(job,i,'CONCLUIDO',item.codigo)});job.status='PROCESSANDO';niceBatchSave_(holder);for(let i=0;i<job.items.length&&processed<5&&Date.now()-started<200000;i++){const item=job.items[i];if(!['PENDENTE','PROCESSANDO'].includes(item.status))continue;processed++;try{item.status='PROCESSANDO';if(!item.codigo)item.codigo='CERT-UJN-CUS-'+Utilities.getUuid().replace(/-/g,'').slice(0,10).toUpperCase();if(!item.emitido)item.emitido=new Date().toISOString();if(!item.registry){item.registry=niceCertBookFindByCode_(item.codigo)||niceCertBookAllocate_({instituicao:c.emissor,codigo:item.codigo,tipo:'CUSTOMIZADO',custom_link_id:c.link_id,nome:item.nome,email:item.email,evento:c.titulo,funcao:item.funcao,carga:item.carga,emitido:item.emitido});}niceBatchSave_(holder);const result=niceBatchGenerateItem_(c,link,job,item);item.pdf_url=result.url;item.status='CONCLUIDO';item.erro='';niceBatchSave_(holder);niceBatchQuotaFinish_(job,i,'CONCLUIDO',item.codigo);}catch(err){item.status='FALHOU';item.erro=String(err.message||err).slice(0,500);niceBatchSave_(holder);niceBatchQuotaFinish_(job,i,'FALHOU',item.codigo);}}
if(job.items.every(x=>['CONCLUIDO','FALHOU'].includes(x.status))){job.status=job.items.some(x=>x.status==='FALHOU')?'PARCIAL':'CONCLUIDO';niceBatchSave_(holder);if(job.entrega==='PENDENTE')niceBatchDeliver_(holder,link);}}
}finally{props.deleteProperty('CERT_LOTES_WORKER');}}
function niceBatchGenerateItem_(c,link,job,item){const sh=niceCertIssuesSheet_(),v=sh.getDataRange().getValues(),h=niceCertHeaderMap_(v[0]),previous=v.slice(1).find(r=>r[h.CODIGO]===item.codigo);if(previous&&previous[h.PDF_URL])return{url:previous[h.PDF_URL]};const r=item.registry,emitted=new Date(item.emitido),signature=niceCertSign_(niceCertCustomCanonicalV3_({codigo:item.codigo,linkId:c.link_id,nome:item.nome,funcao:item.funcao,evento:c.titulo,carga:item.carga,instituicao:c.emissor,livroAta:r.livro_display,registro:r.registro,viaEmitida:'1ª Via Emitida',emitido:item.emitido}));
const cert={nome:item.nome,email:item.email,funcao:item.funcao,carga:item.carga,evento:c.titulo,codigo:item.codigo,signature,emitido:emitted,livro_digital:r.livro_display,registro_digital:r.registro,livro_ata:r.livro_display,registro:r.registro,via_emitida:'1ª Via Emitida',instituicao_emissora:c.emissor},pdf=niceCoursesPdf_(link,cert,Object.assign({},c,{pessoas:[item]})),hash=niceCertBookSha256Blob_(pdf.blob);niceCertBookFinalize_(r,{hash_pdf:hash,pdf_url:pdf.url});niceCertCustomAppendIssue_(sh,{EVENTO_ID:'',NOME:item.nome,EMAIL:item.email,CARGA_HORARIA:item.carga,CODIGO:item.codigo,ASSINATURA_HMAC:signature,STATUS:'ATIVO',EMITIDO_EM:emitted,PDF_URL:pdf.url,TENTATIVAS_EMAIL:0,TIPO_CERTIFICADO:'CUSTOMIZADO',FUNCAO_EVENTO:item.funcao,TITULO_EVENTO_CUSTOM:c.titulo,CUSTOM_LINK_ID:c.link_id,LIVRO_ATA:r.livro_display,REGISTRO_CERTIFICADO:r.registro,VIA_EMITIDA:'1ª Via Emitida',INSTITUICAO_EMISSORA:c.emissor,INSTITUICAO_ID:r.instituicao_id,LIVRO_DIGITAL:r.livro_display,ANO_LIVRO:r.ano,REGISTRO_DIGITAL:r.registro,REGISTRO_ID:r.registro_id,HASH_PDF:hash,PDF_MODELO_VERSAO:pdf.modelo_versao,LOTE_ID:job.id,EMAIL_ENTREGA_LOTE:job.destino});return pdf;}
function niceBatchDeliver_(holder,link){const job=holder.job,completed=job.items.filter(x=>x.status==='CONCLUIDO');if(!completed.length)return;try{const blobs=completed.map((x,i)=>{const id=(String(x.pdf_url).match(/[-\w]{20,}/)||[])[0];return DriveApp.getFileById(id).getBlob().setName(String(i+1).padStart(3,'0')+'-'+x.nome.replace(/[\\/:*?"<>|]/g,' ').slice(0,70)+'-'+x.codigo+'.pdf')});const zip=Utilities.zip(blobs,job.id+'.zip'),file=niceCertFolderFromUrl_(link.pasta_drive).createFile(zip);file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);job.zip_url=file.getUrl();job.entrega='ENVIANDO';niceBatchSave_(holder);const options={name:'UJN · Protocolo.me'};if(zip.getBytes().length<18*1024*1024)options.attachments=[zip];GmailApp.sendEmail(job.destino,'Certificados em lote · '+job.titulo,'Seu lote de certificados está disponível.\n\nEvento: '+job.titulo+'\nPDFs concluídos: '+completed.length+' de '+job.items.length+'\nFalhas: '+job.items.filter(x=>x.status==='FALHOU').length+'\n\nBaixar ZIP: '+job.zip_url+'\n\nPEAS - Technology®',options);job.entrega='ENVIADO';niceBatchSave_(holder);}catch(err){job.entrega='FALHOU';job.erro='Falha na entrega: '+String(err.message||err);niceBatchSave_(holder);}}

function niceBatchEnsureReservations_(job,c){const sh=niceCoursesQuotaSheet_(),v=sh.getDataRange().getValues(),h=niceCertHeaderMap_(v[0]),seen=new Set(v.slice(1).map(r=>r[h.SOLICITACAO_ID])),missing=job.items.map((x,i)=>({x,i})).filter(p=>!seen.has(job.id+'-'+p.i));if(!missing.length)return;if(niceCoursesQuota_(c).disponiveis<missing.length)throw new Error('Saldo insuficiente para completar as reservas deste lote.');const counts={};missing.forEach(p=>counts[p.x.identity]=(counts[p.x.identity]||0)+1);Object.keys(counts).forEach(key=>{const q=niceCoursesQuota_(c,key);if(q.pessoa_usados+counts[key]>q.limite_pessoa)throw new Error('Limite do titular insuficiente: '+key.replace(/^nome:/,''));});const rows=missing.map(({x,i})=>{const o={SOLICITACAO_ID:job.id+'-'+i,CURSO_ID:c.id,EMAIL:x.identity,CODIGO:x.codigo,STATUS:'RESERVADO',CRIADO_EM:new Date(),ATUALIZADO_EM:new Date()};return v[0].map(k=>o[k]||'')});sh.getRange(sh.getLastRow()+1,1,rows.length,v[0].length).setValues(rows);}
